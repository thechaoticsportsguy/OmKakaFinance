# OmKakaFinance secrets - TEMPLATE ONLY.
#
# 1. Copy this file to a new file named ".env" in the same folder:
#        copy .env.example .env
# 2. Open .env in Notepad and fill in real values on YOUR computer only.
# 3. Never paste real values into chat, commits, or screenshots.
#    ".env" is listed in .gitignore so git will not upload it.
#
# Phase 1 does not use any of these. Leaving them blank is fine for now.

# --- Phase 3: Claude API (billed separately from a Claude.ai subscription) ---
ANTHROPIC_API_KEY=

# --- Phase 2: SEC EDGAR requires a descriptive User-Agent with contact info ---
# Example format: "OmKakaFinance your-name your-email@example.com"
SEC_USER_AGENT=

# --- Phase 2: market data / news provider (provider not chosen yet) ---
MARKET_DATA_API_KEY=
NEWS_API_KEY=

# --- Phase 2: official Reddit API (requires Reddit's approval) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
