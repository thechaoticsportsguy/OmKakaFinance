# OmKakaFinance secrets - TEMPLATE ONLY.
#
# 1. Copy this file to a new file named ".env" in the same folder:
#        copy .env.example .env
# 2. Open it:  notepad .env   and fill in values on YOUR computer only.
# 3. Never paste real values into chat, commits, or screenshots.
#    ".env" is listed in .gitignore so git will not upload it.
#
# Plan: $0 additional spending. Every source below is FREE.

# --- SEC EDGAR (free, no key). SEC requires your name and email here. ---
# Example format: OmKakaFinance Jane Doe jane@example.com
SEC_USER_AGENT=

# --- Massive (formerly Polygon.io), free "Stocks Basic" plan: end-of-day prices ---
# Sign up at massive.com (free plan), copy your API key here.
MARKET_DATA_API_KEY=

# --- Finnhub free tier: company news ---
# Sign up at finnhub.io (free), copy your API key here.
NEWS_API_KEY=

# --- Official Reddit Data API: ONLY after Reddit approves your access request ---
# Leave blank until approved. The app then shows Reddit as "Data unavailable".
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# --- NOT USED under the $0 plan (paid AI API). Leave blank. ---
ANTHROPIC_API_KEY=
